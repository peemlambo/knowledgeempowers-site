\" y=\"111.3\" font-family=\"Public Sans\" font-size=\"13\" fill=\"#7A0000\" text-anchor=\"middle\" font-weight=\"bold\">40°</text><path d=\"M166.9,105.9 A22,22 0 0 0 144.3,98.7\" fill=\"none\" stroke=\"#7A0000\" stroke-width=\"1.4\"/><text x=\"160.9\" y=\"90.0\" font-family=\"Public Sans\" font-size=\"13\" fill=\"#7A0000\" text-anchor=\"middle\" font-weight=\"bold\">x</text><path d=\"M144.3,98.7 A22,22 0 0 0 128.0,120.0\" fill=\"none\" stroke=\"#7A0000\" stroke-width=\"1.4\"/><text x=\"119.4\" y=\"101.0\" font-family=\"Public Sans\" font-size=\"13\" fill=\"#7A0000\" text-anchor=\"middle\" font-weight=\"bold\">75°</text><circle cx=\"150.0\" cy=\"120.0\" r=\"3.2\" fill=\"#444444\"/></g></svg></span></div>","parts":[{"t":"box","label":"x (°)","a":"65","form":"val","o":null}],"hint":"180 − 40 − 75","steps":"1. Rule: angles on a straight line add up to 180°.<br>2. x = 180° − 40° − 75°<br>3. = 65°"},{"text":"Find x.","vis":"<div class=\"vis\"><span class=\"vi\"><svg xmlns=\"http://www.w3.org/2000/svg\" style=\"width:236px;height:auto\" viewBox=\"0 0 181.75146656328027 170.95243829050227\"><g transform=\"translate(-68.2,-21.2)\"><line x1=\"150.0\" y1=\"120.0\" x2=\"228.0\" y2=\"120.0\" stroke=\"#555555\" stroke-width=\"1.6\"/><line x1=\"150.0\" y1=\"120.0\" x2=\"136.5\" y2=\"43.2\" stroke=\"#555555\" stroke-width=\"1.6\"/><line x1=\"150.0\" y1=\"120.0\" x2=\"90.2\" y2=\"170.1\" stroke=\"#555555\" stroke-width=\"1.6\"/><path d=\"M172.0,120.0 A22,22 0 0 0 146.2,98.3\" fill=\"none\" stroke=\"#7A0000\" stroke-width=\"1.4\"/><text x=\"177.6\" y=\"91.6\" font-family=\"Public Sans\" font-size=\"13\" fill=\"#7A0000\" text-anchor=\"middle\" font-weight=\"bold\">100°</text><path d=\"M146.2,98.3 A22,22 0 0 0 133.1,134.1\" fill=\"none\" stroke=\"#7A0000\" stroke-width=\"1.4\"/><text x=\"109.6\" y=\"109.8\" font-family=\"Public Sans\" font-size=\"13\" fill=\"#7A0000\" text-anchor=\"middle\" font-weight=\"bold\">120°</text><path d=\"M133.1,134.1 A22,22 0 0 0 172.0,120.0\" fill=\"none\" stroke=\"#7A0000\" stroke-width=\"1.4\"/><text x=\"162.4\" y=\"158.5\" font-family=\"Public Sans\" font-size=\"13\" fill=\"#7A0000\" text-anchor=\"middle\" font-weight=\"bold\">x</text><circle cx=\"150.0\" cy=\"120.0\" r=\"3.2\" fill=\"#444444\"/></g></svg></span></div>","parts":[{"t":"box","label":"x (°)","a":"140","form":"val","o":null}],"hint":"360 − 100 − 120","steps":"1. Rule: angles around a point add up to 360°.<br>2. x = 360° − 100° − 120°<br>3. = 140°"},{"text":"Find the complement of 35°.","vis":"","parts":[{"t":"box","label":"Complement (°)","a":"55","form":"val","o":null}],"hint":"90 − 35","steps":"1. Rule: complementary angles add up to 90°; supplementary angles add up to 180°.<br>2. complement = 90° − 35°<br>3. = 55°"}]}
9\" fill=\"#444444\" text-anchor=\"middle\" font-weight=\"normal\">3</text><text x=\"258.0\" y=\"141.0\" font-family=\"Public Sans\" font-size=\"9\" fill=\"#444444\" text-anchor=\"middle\" font-weight=\"normal\">4</text><text x=\"284.0\" y=\"141.0\" font-family=\"Public Sans\" font-size=\"9\" fill=\"#444444\" text-anchor=\"middle\" font-weight=\"normal\">5</text><text x=\"150.0\" y=\"235.0\" font-family=\"Public Sans\" font-size=\"9\" fill=\"#444444\" text-anchor=\"end\" font-weight=\"normal\">−4</text><text x=\"150.0\" y=\"209.0\" font-family=\"Public Sans\" font-size=\"9\" fill=\"#444444\" text-anchor=\"end\" font-weight=\"normal\">−3</text><text x=\"150.0\" y=\"183.0\" font-family=\"Public Sans\" font-size=\"9\" fill=\"#444444\" text-anchor=\"end\" font-weight=\"normal\">−2</text><text x=\"150.0\" y=\"157.0\" font-family=\"Public Sans\" font-size=\"9\" fill=\"#444444\" text-anchor=\"end\" font-weight=\"normal\">−1</text><text x=\"150.0\" y=\"105.0\" font-family=\"Public Sans\" font-size=\"9\" fill=\"#444444\" text-anchor=\"end\" font-weight=\"normal\">1</text><text x=\"150.0\" y=\"79.0\" font-family=\"Public Sans\" font-size=\"9\" fill=\"#444444\" text-anchor=\"end\" font-weight=\"normal\">2</text><text x=\"150.0\" y=\"53.0\" font-family=\"Public Sans\" font-size=\"9\" fill=\"#444444\" text-anchor=\"end\" font-weight=\"normal\">3</text><text x=\"150.0\" y=\"27.0\" font-family=\"Public Sans\" font-size=\"9\" fill=\"#444444\" text-anchor=\"end\" font-weight=\"normal\">4</text><text x=\"149.0\" y=\"141.0\" font-family=\"Public Sans\" font-size=\"9\" fill=\"#444444\" text-anchor=\"end\" font-weight=\"normal\">0</text><circle cx=\"232\" cy=\"76\" r=\"2.8\" fill=\"#7A0000\"/><text x=\"237.0\" y=\"71.0\" font-family=\"Public Sans\" font-size=\"11\" fill=\"#7A0000\" text-anchor=\"start\" font-weight=\"bold\">A</text><circle cx=\"50\" cy=\"102\" r=\"2.8\" fill=\"#7A0000\"/><text x=\"55.0\" y=\"97.0\" font-family=\"Public Sans\" font-size=\"11\" fill=\"#7A0000\" text-anchor=\"start\" font-weight=\"bold\">B</text><circle cx=\"102\" cy=\"206\" r=\"2.8\" fill=\"#7A0000\"/><text x=\"107.0\" y=\"201.0\" font-family=\"Public Sans\" font-size=\"11\" fill=\"#7A0000\" text-anchor=\"start\" font-weight=\"bold\">C</text><circle cx=\"258\" cy=\"180\" r=\"2.8\" fill=\"#7A0000\"/><text x=\"263.0\" y=\"175.0\" font-family=\"Public Sans\" font-size=\"11\" fill=\"#7A0000\" text-anchor=\"start\" font-weight=\"bold\">D</text></svg></span></div>","ex":{"q":"ABCD is a rectangle with A(−2; 3), B(4; 3) and C(4; −1). Find D.","steps":["A and B have the same y, so the top side is horizontal.","D is below A, so D has A’s x-coordinate, −2.","D is level with C, so y = −1. D(−2; −1)."]},"watch":"x first (across), then y (up or down).<br><br><b>Problem-solving lens</b><br>Sketch a quick grid and plot the points you know before you work anything out.","qs":[{"text":"ABCD is a rectangle with A(−3; 2), B(1; 2) and C(1; −4). Find D.","vis":"","parts":[{"t":"box","label":"x","a":"-3","form":"val","o":null},{"t":"box","label":"y","a":"-4","form":"val","o":null}],"hint":"x of A, y of C.","steps":"1. Rule: in a rectangle with sides along the grid lines, D lines up across from C and up and down from A.<br>2. D has the x of A: −3.<br>3. D has the y of C: −4.<br>4. D = (−3; −4)"},{"text":"A boat is at (−3; 4) on a chart. It sails 5 units right and 6 units down. Where is it now?","vis":"","parts":[{"t":"box","label":"x","a":"2","form":"val","o":null},{"t":"box","label":"y","a":"-2","form":"val","o":null}],"hint":"(−3 + 5; 4 − 6)","steps":"1. Rule: translation (x; y) → (x + a; y + b). Right or up: add. Left or down: subtract.<br>2. new position = (−3 + 5; 4 − 6)<br>3. = (2; −2)"},{"text":"In which quadrant is (−5; 2)? Circle one.","vis":"","self":1,"parts":[{"label":null}],"hint":"(−; +)","steps":"1. Rule: quadrants by signs: first (+; +), second (−; +), third (−; −), fourth (+; −).<br>2. (−5; 2): the signs are (−; +).<br>3. That is the second quadrant. Answer: B."}]}